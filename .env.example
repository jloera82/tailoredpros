# Server-side only (Vercel serverless function) — do NOT prefix with VITE_,
# that would expose it to the browser bundle. Set the real value in Vercel's
# project Environment Variables, or in .env.local for local `vercel dev`.
LEAD_CAPTURE_API_KEY=

# Optional: override the capture endpoint (defaults to the test endpoint).
# Set to https://exchange.standardinformation.io/capture when ready to go live.
LEAD_CAPTURE_URL=
